# Capability Map Application Environment Variables
# Copy this to .env and configure for your environment

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Editor Authentication
# Legacy shared password (optional once real accounts exist in config/auth.php)
EDITOR_PASSWORD=your_secure_password_here_minimum_32_characters
# Secret used to sign the login cookie for multi-user accounts. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=a_long_random_string_generated_with_openssl_rand_hex_32