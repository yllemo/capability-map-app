# Capability Map Application Environment Variables
# Copy this to config/.env and configure for your environment

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Editor Authentication
# Legacy shared password (optional once real accounts exist in config/auth.php)
EDITOR_PASSWORD=your_secure_password_here_minimum_32_characters
# Secret used to sign the login cookie for multi-user accounts. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=a_long_random_string_generated_with_openssl_rand_hex_32

# MCP: browser origins must match exactly (no path or trailing slash).
MCP_ALLOWED_ORIGINS=https://your-capability-map.example
# Existing account used by the external MCP client. Its normal map ACL applies.
MCP_TOKEN_USER=mcp-reader
# SHA-256 of a separately generated random token (not the account password).
MCP_TOKEN_SHA256=
MCP_ALLOW_ANONYMOUS=0
